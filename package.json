{
  "type": "module",
  "scripts": {
    "check:syntax": "find . -type f -name '*.js' -not -path './node_modules/*' -print0 | xargs -0 -n1 node --check",
    "test": "node --test $(find tests -type f -name '*.test.js' ! -name 'firestore-rules.test.js' -print)",
    "test:firestore-rules": "FIRESTORE_RULES_REQUIRED=1 firebase emulators:exec --only firestore \"node --test tests/firestore-rules.test.js\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase": "^12.16.0",
    "firebase-tools": "^15.23.0"
  }
}
