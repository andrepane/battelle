rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function authDoc() { return get(/databases/$(database)/documents/authorizedUsers/$(request.auth.uid)); }
    function authorizedNeurointegra() {
      return signedIn()
        && exists(/databases/$(database)/documents/authorizedUsers/$(request.auth.uid))
        && authDoc().data.active == true
        && authDoc().data.organizationId == 'neurointegra';
    }
    function adminNeurointegra() {
      return authorizedNeurointegra() && authDoc().data.role == 'admin';
    }
    function maintenanceActive() {
      return exists(/databases/$(database)/documents/organizations/neurointegra/system/maintenance)
        && get(/databases/$(database)/documents/organizations/neurointegra/system/maintenance).data.mode == 'maintenance';
    }
    function assessmentsAvailable() { return !maintenanceActive() || adminNeurointegra(); }
    function validMaintenanceDocument() {
      return request.resource.data.keys().hasOnly(['mode','message','refreshId','updatedAt','updatedBy'])
        && request.resource.data.mode in ['open','draining','maintenance']
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 240
        && (!request.resource.data.keys().hasAny(['refreshId']) || request.resource.data.refreshId == null || (request.resource.data.refreshId is string && request.resource.data.refreshId.size() <= 100))
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }
    function validSessionDocument(sessionId) {
      return request.resource.data.keys().hasOnly(['id','uid','role','email','view','assessmentId','therapistName','pending','lastSeen'])
        && request.resource.data.id == sessionId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == (authDoc().data.role == 'admin' ? 'admin' : 'shared')
        && request.resource.data.email is string
        && request.resource.data.view in ['home','assessment']
        && (request.resource.data.assessmentId == null || request.resource.data.assessmentId is string)
        && (request.resource.data.therapistName == null || request.resource.data.therapistName is string)
        && request.resource.data.pending is bool
        && request.resource.data.lastSeen == request.time;
    }
    function assessmentFields() {
      return ['id','schemaVersion','referenceAssessmentId','name','therapistName','birthDate','assessmentDate','manualAgeOverride','ageMonths','observedResponses','observations','createdAt','updatedAt','revision','workflowStatus','correctionMetadata','progress','organizationId','createdBy','updatedBy','deletedAt','deletedBy','deletionRevision'];
    }
    function validWorkflowStatus() {
      return request.resource.data.workflowStatus in ['borrador','pendiente_completar','correccion_bloqueada','corregida','resultado_desactualizado'];
    }
    function validAssessmentShape(assessmentId) {
      return request.resource.data.keys().hasOnly(assessmentFields())
        && request.resource.data.id == assessmentId
        && request.resource.data.organizationId == 'neurointegra'
        && request.resource.data.schemaVersion == 3
        && (!request.resource.data.keys().hasAny(['referenceAssessmentId']) || request.resource.data.referenceAssessmentId == null || (request.resource.data.referenceAssessmentId is string && request.resource.data.referenceAssessmentId.matches('^[A-Za-z0-9][A-Za-z0-9_-]{2,80}$') && request.resource.data.referenceAssessmentId != assessmentId))
        && request.resource.data.revision is int
        && request.resource.data.revision > 0
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.name is string
        && (!request.resource.data.keys().hasAny(['therapistName']) || request.resource.data.therapistName == null || (request.resource.data.therapistName is string && request.resource.data.therapistName.matches('.*[^\\s].*') && request.resource.data.therapistName.size() <= 100))
        && request.resource.data.birthDate is string
        && request.resource.data.assessmentDate is string
        && request.resource.data.manualAgeOverride is bool
        && (request.resource.data.ageMonths == null || request.resource.data.ageMonths is int)
        && request.resource.data.observedResponses is map
        && request.resource.data.observations is map
        && request.resource.data.correctionMetadata is map
        && request.resource.data.progress is map
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt == request.time
        && ((request.resource.data.deletedAt == null && request.resource.data.deletedBy == null && request.resource.data.deletionRevision == null) || (request.resource.data.deletedAt == request.time && request.resource.data.deletedBy == request.auth.uid && request.resource.data.deletionRevision == request.resource.data.revision))
        && validWorkflowStatus();
    }
    function validAssessmentCreate(assessmentId) {
      return validAssessmentShape(assessmentId)
        && request.resource.data.revision == 1
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
    }
    function validAssessmentUpdate(assessmentId) {
      return validAssessmentShape(assessmentId)
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;
    }
    match /authorizedUsers/{uid} {
      allow get: if signedIn() && uid == request.auth.uid;
      allow list, create, update, delete: if false;
    }
    match /organizations/neurointegra/assessments/{assessmentId} {
      allow read: if authorizedNeurointegra() && assessmentsAvailable();
      allow create: if authorizedNeurointegra() && assessmentsAvailable() && validAssessmentCreate(assessmentId);
      allow update: if authorizedNeurointegra() && assessmentsAvailable() && validAssessmentUpdate(assessmentId);
      allow delete: if authorizedNeurointegra() && assessmentsAvailable() && resource.data.deletedAt != null;
    }
    match /organizations/neurointegra/system/maintenance {
      allow read: if authorizedNeurointegra();
      allow create, update: if adminNeurointegra() && validMaintenanceDocument();
      allow delete: if false;
    }
    match /organizations/neurointegra/sessions/{sessionId} {
      allow read: if adminNeurointegra();
      allow create, update: if authorizedNeurointegra() && validSessionDocument(sessionId);
      allow delete: if authorizedNeurointegra() && (resource.data.uid == request.auth.uid || adminNeurointegra());
    }
    match /organizations/neurointegra/previewMaintenance/{environmentId} {
      allow read: if authorizedNeurointegra();
      allow create, update: if adminNeurointegra() && validMaintenanceDocument();
      allow delete: if adminNeurointegra();
    }
    match /organizations/neurointegra/previewSessions/{environmentId}/sessions/{sessionId} {
      allow read: if adminNeurointegra();
      allow create, update: if authorizedNeurointegra() && validSessionDocument(sessionId);
      allow delete: if authorizedNeurointegra() && (resource.data.uid == request.auth.uid || adminNeurointegra());
    }
    match /{document=**} { allow read, write: if false; }
  }
}
